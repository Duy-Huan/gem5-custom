@startuml
skinparam BoxPadding 10
skinparam ParticipantPadding 10
autonumber

box "CPU Core" #LightBlue
participant "RISC-V CPU" as CPU
end box

box "AuRORA Client" #LightYellow
participant "Client::CpuPort\n(ResponsePort)" as Client_CpuPort
participant "Tracker Register Sets\n(16x cfg[acq|mgr_id] + 4x RROPC + 16 credit pools\n+ 1 shared control FSM: cfg_acq_state)" as Tracker
participant "Instruction Sender\n(RequestorPort, 1-3 beat serializer)" as Client_NocPort
end box

box "gem5 NoC (Garnet)" #LightGray
participant "Garnet NoC\n(Router/VirtualChannel)" as NoC
end box

box "AuRORA Manager Shim" #LightGreen
participant "Instruction Receiver\n(ResponsePort)" as Mgr_NocPort
participant "Manager Core\n(s_idle/s_active/s_rel_wait/s_sfence/s_unbusy\n+ Shadow Regs + inst_q depth=4)" as Mgr_Core
participant "MMU Subsystem\n(rocket-chip PTW + optional L2TLB/PTECache,\ndefault OFF, 0 entries)" as Mgr_MMU
participant "MEM Req Throttler\n[KHONG TON TAI trong ucb-bar/rerocc -\nchi 1 dong comment, xem review doc muc 1.1]" as Mgr_MemSender
end box

box "Accelerator" #Khaki
participant "Gemini Accel" as Gemini
end box

== 0. Ghi chú field/opcode thật (bus/Protocol.scala) ==
note over CPU, Mgr_MemSender
  m*: mAcquire=0(1beat) mInst=1(1-3beat: inst,rs1?,rs2?) mUStatus=2(2beat)
      mUPtbr=3(1beat) mRelease=4(1beat) mUnbusy=5(1beat)
  s*: sAcqResp=0 sInstAck=1 sWrite=2(2beat: data,rd) sRelResp=3 sUnbusyAck=4
  CSR map: RROPC0-3(0x800-803, 4 decode slot) RRBAR(0x804) RRCFG0-15(0x810-81f, 9bit: acq|mgr_id)
end note

== 1. rerocc_acquire: ghi CSR RRCFGn (software: rr_acquire_single) ==
CPU -> Client_CpuPort : swap_csr(RRCFGn, ACQ=1 | mgr_id)
activate Client_CpuPort
Client_CpuPort -> Tracker : Check cfg_acq_state==s_idle (FSM DUNG CHUNG cho ca 16 cfg)\n+ valid_mgr (mgr_id co trong edge.mParams.managers?)
activate Tracker

alt cfg_acq_state != s_idle (dang co giao dich khac)\nHOAC mgr_id khong hop le
    Tracker --> Client_CpuPort : Khong gui gi ra NoC (loi bat local, khong tron round-trip)
    Client_CpuPort --> CPU : CSR readback: acq bit van = 0
else FSM ranh, mgr_id hop le
    Tracker -> Tracker : cfg_acq_state := s_acq ; cfg_acq_id := n ; cfg_acq_mgr_id := mgr_id
    Tracker -> Client_NocPort : req_arb.in(0): mAcquire(client_id=n, manager_id=mgr_id)
    activate Client_NocPort
    Client_NocPort -> NoC : sendTimingReq(mAcquire)
    activate NoC
    NoC -> Mgr_NocPort : sendTimingReq(mAcquire)
    activate Mgr_NocPort
    Mgr_NocPort -> Mgr_Core : rr_req.bits.opcode==mAcquire
    activate Mgr_Core

    alt Manager.state != s_idle (dang ACQUIRED boi client khac)
        Mgr_Core -> Mgr_Core : resp_arb.in(0).data := (state===s_idle) = false
        Mgr_Core --> Mgr_NocPort : sAcqResp(data(0)=0)
        Mgr_NocPort --> NoC : sendTimingReq(sAcqResp denied)
        NoC --> Client_NocPort : sendTimingReq(sAcqResp denied)
        Client_NocPort --> Tracker : cfg_acq_state := s_idle\ncsr_cfg_next(n).acq := 0 ; .mgr := mgr_id (van ghi, dung de debug)
        Tracker --> CPU : readback RRCFGn: acq=0 (FAIL)
        note over CPU
          rr_acquire_multi() trong rerocc.h: vong lap thu accelId KHAC
          trong pool cung chuc nang, KHONG phai retry cung accelId.
        end note
    else Manager.state == s_idle
        Mgr_Core -> Mgr_Core : state := s_active ; client := n
        Mgr_Core --> Mgr_NocPort : sAcqResp(data(0)=1)
        Mgr_NocPort --> NoC : sendTimingReq(sAcqResp granted)
        NoC --> Client_NocPort : sendTimingReq(sAcqResp granted)
        Client_NocPort --> Tracker : cfg_acq_state := s_idle\ncsr_cfg_next(n).acq:=1 ; .mgr:=mgr_id\ncfg_updatestatus(n):=true ; cfg_updateptbr(n):=true
        Tracker --> CPU : readback RRCFGn: acq=1 (SUCCESS)
    end
    deactivate Mgr_Core
    deactivate Mgr_NocPort
    deactivate NoC
    deactivate Client_NocPort
end
deactivate Tracker
deactivate Client_CpuPort

== 2. Tu dong dong bo Shadow Regs sau acquire thanh cong (mUStatus 2-beat + mUPtbr 1-beat) ==
note over Tracker
  Day la 2 giao dich RIENG, chay qua CUNG 1 FSM (cfg_acq_state:
  s_status0 -> s_status1 -> s_ptbr -> s_idle), TU DONG kich hoat
  vi cfg_updatestatus(n)/cfg_updateptbr(n) vua duoc set = true o buoc 1.
  KHONG gop chung vao goi Acquire nhu v3 mo ta.
end note
Tracker -> Client_NocPort : mUStatus beat0 = mstatus[63:0]
Client_NocPort -> NoC : sendTimingReq
NoC -> Mgr_NocPort : sendTimingReq
Tracker -> Client_NocPort : mUStatus beat1 = mstatus[127:64]
Client_NocPort -> NoC : sendTimingReq
NoC -> Mgr_NocPort : sendTimingReq
Mgr_NocPort -> Mgr_Core : status := Cat(beat1,beat0)  [chi apply khi !inst_q.deq.valid && !io.busy]
Tracker -> Client_NocPort : mUPtbr beat0 = ptbr
Client_NocPort -> NoC : sendTimingReq
NoC -> Mgr_NocPort : sendTimingReq
Mgr_NocPort -> Mgr_Core : ptbr := beat0  [chi apply khi !inst_q.deq.valid && !io.busy]
note over Mgr_Core
  Manager cung TU DONG re-sync status/ptbr moi khi core doi
  ptbr/status (vd context switch) - ap dung cho MOI cfg dang acquire,
  khong chi luc acquire lan dau (Client.scala:281-282).
end note

== 3. rerocc_assign tuong duong: ghi CSR RROPCn = cfg_id (rr_set_opc) ==
CPU -> Client_CpuPort : write_rr_csr(RROPC_k, cfg_id=n)
activate Client_CpuPort
Client_CpuPort -> Tracker : csr_opc(k) := n  (k = 0..3, KHONG qua FSM chinh, ghi truc tiep)
Client_CpuPort --> CPU : done (khong co ack tu Manager, day la CSR local thuan)
deactivate Client_CpuPort
note over Tracker : Tu day, RoCC custom instr dung opcode field bit[6:5]=k\nse tu dong duoc route toi cfg n / Manager tuong ung.

== 4. Issue RoCC custom instruction (data-plane, doc lap voi FSM neu FSM dang s_idle) ==
CPU -> Client_CpuPort : ROCC_INSTRUCTION(opcode=k, rs1?, rs2?, rd?)
activate Client_CpuPort
Client_CpuPort -> Tracker : cmd_cfg_id := csr_opc(k)\ncheck: credit_available(cfg_credits(cfg_id)!=0 && cfg.acq)\n&& status_ready && ptbr_ready && cfg_acq_state==s_idle
activate Tracker

alt Dieu kien KHONG thoa (het credit / dang cho status-ptbr / FSM dang ban cho cfg KHAC)
    Tracker --> Client_CpuPort : io.cmd.ready = false
    Client_CpuPort --> CPU : Stall (backpressure, RoCC busy)
    note over Tracker
      LUU Y: cfg_acq_state=/=s_idle chan phat lenh cho TAT CA cfg,
      ke ca cfg khong lien quan giao dich dang cho -> head-of-line
      blocking tiem an giua cac accelerator khac nhau tren cung Client.
    end note
else OK
    Tracker -> Tracker : cfg_credits(cfg_id)--
    Client_CpuPort --> CPU : Return TRUE (non-blocking ACK)
    Tracker -> Client_NocPort : Trigger InstructionSender (state s_inst)
    activate Client_NocPort
    Client_NocPort -> Client_NocPort : beat0 = inst encoding
    Client_NocPort -> NoC : sendTimingReq(mInst beat0)
    activate NoC
    NoC -> Mgr_NocPort : sendTimingReq(mInst beat0)

    alt inst.xs1 == true
        Client_NocPort -> NoC : sendTimingReq(mInst beat1 = rs1)
        NoC -> Mgr_NocPort : sendTimingReq(mInst beat1)
    end
    alt inst.xs2 == true
        note over Client_NocPort
          [NGHI VAN BUG RTL - xem review doc muc 6]
          Neu xs1=false VA xs2=true, logic goc luon nhay ve s_inst
          va KHONG gui beat rs2. Can testcase xs1=0,xs2=1 de xac nhan
          truoc khi quyet dinh port nguyen bug hay sua trong gem5.
        end note
        Client_NocPort -> NoC : sendTimingReq(mInst beat_rs2 = rs2) [neu logic dung]
        NoC -> Mgr_NocPort : sendTimingReq(mInst beat_rs2)
    end
    deactivate NoC
    deactivate Client_NocPort

    Mgr_NocPort -> Mgr_Core : assert(state==s_active) ; push RoCCCommand vao inst_q (depth=4)
    Mgr_Core -> Mgr_NocPort : sInstAck (ACK khi nap vao inst_q,\nKHONG phai luc thuc thi xong)
    Mgr_NocPort -> NoC : sendTimingReq(sInstAck)
    NoC -> Client_NocPort : sendTimingReq(sInstAck)
    Client_NocPort -> Tracker : cfg_credits(cfg_id)++ (tra credit ngay tai day)
end
deactivate Tracker
deactivate Client_CpuPort

== 5. Execution & Address Translation tren Manager ==
Mgr_Core -> Mgr_Core : Pop RoCCCommand tiep theo khoi inst_q (in-order, FIFO don)
Mgr_Core -> Gemini : Trigger Hardware Compute\n(inst.opcode co dinh = roccOpcode cua accelerator,\nKHONG phu thuoc opcode field phia Client)
activate Gemini

group Address Translation (Manager MMU dung Shadow ptbr/status)
    Gemini -> Mgr_MMU : Translate VA -> PA (qua PTW.io.requestor, dung ptbr da shadow)
    activate Mgr_MMU
    Mgr_MMU -> Mgr_MMU : Neu l2TLBEntries=0/nPTECacheEntries=0 (mac dinh):\nwalk page table tu dau, KHONG co cache nao
    Mgr_MMU --> Gemini : Return PA
    deactivate Mgr_MMU

    Gemini -> Mgr_MemSender : Memory request (PA) qua MiniDCache/HellaMMIO
    activate Mgr_MemSender
    note over Mgr_MemSender
      Trong ucb-bar/rerocc: request di THANG qua TileLink xbar
      (tlXbar) toi he thong bo nho, KHONG co buoc throttle/shape
      nao xen giua. Neu ban muon co throttling that trong model
      gem5, day la phan PHAI TU THIET KE (xem review doc muc 1.1,8.1).
    end note
    Mgr_MemSender --> Gemini : Data / Completion
    deactivate Mgr_MemSender
end

Gemini --> Mgr_Core : Ket qua tinh toan xong
deactivate Gemini

== 6. Writeback (sWrite, 2-beat: data truoc, rd sau) ==
Mgr_Core -> Mgr_NocPort : resp_arb.in(2): sWrite beat0=data
Mgr_NocPort -> NoC : sendTimingReq
activate NoC
NoC -> Client_NocPort : sendTimingReq(sWrite beat0=data)
activate Client_NocPort
Client_NocPort -> Tracker : resp_data := data (luu tam, resp_first)

Mgr_Core -> Mgr_NocPort : resp_arb.in(2): sWrite beat1=rd
Mgr_NocPort -> NoC : sendTimingReq
NoC -> Client_NocPort : sendTimingReq(sWrite beat1=rd)
Client_NocPort -> Tracker : io.resp.bits.rd := rd ; io.resp.bits.data := resp_data (resp_last)
deactivate NoC
deactivate Client_NocPort
Tracker -> CPU : Writeback Register rd
deactivate Tracker

== 7. (Optional) rerocc_fence: CSR RRBAR + fence, roi mUnbusy/sUnbusyAck ==
CPU -> Client_CpuPort : write_rr_csr(RRBAR, cfg_id=n) ; asm fence
activate Client_CpuPort
Client_CpuPort -> Tracker : cfg_fence_state(n) := f_req\n(chi gui mUnbusy khi !inst_sender.busy && !io.cmd.valid)
activate Tracker
Tracker -> Client_NocPort : req_arb.in(2): mUnbusy(client_id=n)
activate Client_NocPort
Client_NocPort -> NoC : sendTimingReq(mUnbusy)
NoC -> Mgr_NocPort : sendTimingReq(mUnbusy)
Mgr_NocPort -> Mgr_Core : state := s_unbusy
Mgr_Core -> Mgr_Core : Cho den khi !io.busy(accel) && inst_q.count==0
Mgr_Core -> Mgr_NocPort : sUnbusyAck ; state := s_active
Mgr_NocPort -> NoC : sendTimingReq(sUnbusyAck)
NoC -> Client_NocPort : sendTimingReq(sUnbusyAck)
Client_NocPort -> Tracker : cfg_fence_state(n) := f_idle
deactivate Client_NocPort
Tracker --> CPU : fence retire (dam bao accelerator da drain,\nbo sung cho memory-ordering cua RISC-V fence)
deactivate Tracker
deactivate Client_CpuPort

== 8. rerocc_release: ghi CSR RRCFGn = 0 (rr_release) ==
CPU -> Client_CpuPort : write_rr_csr(RRCFGn, 0)
activate Client_CpuPort
Client_CpuPort -> Tracker : csr_cfg_next(n) := 0 NGAY LAP TUC (KHONG doi sRelResp)\ncfg_acq_state := s_rel (neu FSM dang s_idle)
activate Tracker
Client_CpuPort --> CPU : return ngay (non-blocking, optimistic)
deactivate Client_CpuPort
Tracker -> Client_NocPort : req_arb.in(0): mRelease(client_id=n)
activate Client_NocPort
Client_NocPort -> NoC : sendTimingReq(mRelease)
NoC -> Mgr_NocPort : sendTimingReq(mRelease)
Mgr_NocPort -> Mgr_Core : state := s_rel_wait
Mgr_Core -> Mgr_Core : Cho den khi !io.busy(accel) && inst_q.count==0 (drain het)
Mgr_Core -> Mgr_NocPort : sRelResp
Mgr_Core -> Mgr_Core : state := s_sfence -> io.ptw.sfence.valid=true\n(XOA SACH TLB/PTE-cache cua tenant vua release)
Mgr_Core -> Mgr_Core : state := s_idle
Mgr_NocPort -> NoC : sendTimingReq(sRelResp)
NoC -> Client_NocPort : sendTimingReq(sRelResp)
Client_NocPort -> Tracker : cfg_acq_state := s_idle
deactivate Client_NocPort
deactivate Tracker

note over Mgr_Core
  QUAN TRONG cho tape-out: SFENCE nay la co che cach ly bat buoc
  cho multi-tenant. Neu client khac acquire dung Manager nay TRUOC
  khi sRelResp+sfence hoan tat, se bi NACK tam thoi (state != s_idle)
  - software PHAI co retry loop, khong duoc gia dinh release la tuc thoi.
end note

@enduml
