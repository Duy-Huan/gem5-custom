@startuml
skinparam componentStyle uml2
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultTextAlignment center
skinparam nodesep 50
skinparam ranksep 40

' Định dạng khung ngoài Subsystem
skinparam package {
    BackgroundColor Transparent
    BorderColor #333333
    BorderThickness 2
    FontSize 18
    FontStyle bold
}

' Định dạng các Sub-module lớn
skinparam rectangle {
    RoundCorner 8
    BorderThickness 1.5
    BorderColor #555555
    FontSize 15
    FontStyle bold
}

' Định dạng các khối linh kiện chi tiết
skinparam component {
    RoundCorner 4
    BorderThickness 1
    BorderColor #777777
    BackgroundColor #FFFFFF
    FontSize 14
}

' ==========================================
' EXTERNAL INTERFACES & PORTS
' ==========================================
interface "CPU Pipeline / Register File\n(gem5 TimingSimpleCPU Base)" as P_CPU_CORE #F4B183
interface "CPU Stall / Interlock\n(Pipeline Flow Control)" as P_CPU_STALL #FF7F50

' SUA: gem5 RequestPort (src/mem/port.hh) la 1 OBJECT DUY NHAT xu ly CA
' 2 chieu (sendTimingReq + recvTimingResp) - KHONG tach 2 port rieng
' nhu ban cu. Hop nhat lai cho khop voi client_sa.puml (da dung dung
' 1 port tu truoc).
interface "ReRoCC NoC Port\n(RequestPort - sendTimingReq\nmAcquire/mInst/... VA\nrecvTimingResp sAcqResp/sWrite/...)" as P_ROCC_NOC #4A90E2


' ==========================================
' CUSTOM RISC-V CPU ARCHITECTURE
' ==========================================
package "Custom RISC-V CPU (TimingSimpleCPU Extended)" {

    ' Khối Pipeline cơ sở từ gem5
    rectangle "Base CPU Pipeline" as BASE_CPU #E8F8F5 {
        component "Fetch / Decode / Execute\n(gem5 TimingSimpleCPU Core)" as CorePipeline
        component "Architectural Register File\n(Integer / rd / Vector)" as RegFile
    }

    ' Khoi Client Tracker & Quan ly giao dich - SUA: KHONG phai bang
    ' Transaction-ID, RTL that dung 16 credit pool doc lap theo cfg
    ' + 1 FSM dieu khien dung chung (Client.scala:15,85-93,107).
    rectangle "AuRORA Client Tracker Subsystem" as TRACKER_SUB #FCF3CF {
        component "RoCC Instruction Queue\n(Command Buffer)" as CmdBuf
        component "RoCC Decoder &\nPacket Formatter" as Dispatcher
        
        component "Per-cfg Credit Pools\n(16x cfg_credits, depth=4/pool)\n[KHONG phai Transaction-ID table]" as TxTracker
        component "Shared Control FSM\n(cfg_acq_state - DUNG CHUNG\nca 16 cfg, khong rieng tung Tx)" as SyncMgr
        
        component "Response Unpacker\n& FIFO" as RespFIFO
        component "Register File Arbiter\n(Writeback Controller)" as WBArbiter
    }

    ' ------------------------------------------
    ' INTERNAL ROUTING (Đường đi tín hiệu nội bộ)
    ' ------------------------------------------
    CorePipeline -down-> CmdBuf : " Custom RoCC Ops\n(opcode field[6:5]=0..3,\nmap qua CSR RROPC0-3 -> cfg_id)"
    CmdBuf -down-> Dispatcher : " Raw RoCC Instruction"
    Dispatcher -down-> TxTracker : " cfg_credits(cfg_id)--\n(chi khi credit>0 && cfg.acq)"
    
    ' SUA: dieu kien stall that la credit==0 HOAC cfg_acq_state!=s_idle.
    ' Dieu kien resume/fence THAT phai doi sUnbusyAck TU MANAGER
    ' (round-trip NoC), khong phai "Pending Count==0" cuc bo - xem
    ' note trong client_sa.puml va aurora_sequence_v4.puml buoc 7.
    SyncMgr -up-> P_CPU_STALL : " Assert Stall / freeze(tickEvent)\n(credit==0 HOAC\ncfg_acq_state != s_idle)"
    TxTracker -right-> SyncMgr : " credit_available &&\nstatus_ready && ptbr_ready"
    SyncMgr -up-> CorePipeline : " Resume Pipeline / Unfreeze"

    ' SUA: 1 RequestPort duy nhat xu ly ca 2 chieu (khong tach CMD/RESP)
    Dispatcher -right-> P_ROCC_NOC : " sendTimingReq()\n(mAcquire/mInst/mUStatus/mUPtbr/\nmRelease/mUnbusy)"
    P_ROCC_NOC -left-> RespFIFO : " recvTimingResp()\n(sAcqResp/sInstAck/sWrite/\nsRelResp/sUnbusyAck)"
    
    ' Luồng Writeback trả kết quả về CPU Register File
    RespFIFO -down-> WBArbiter
    WBArbiter -up-> RegFile : " Writeback rd / Data"
}

' ==========================================
' EXTERNAL CONNECTIONS
' ==========================================
P_CPU_CORE -down-> CorePipeline
note right of P_ROCC_NOC
  1 RequestPort DUY NHAT noi thang toi
  Garnet/xbar cua he thong (khong qua
  lop trung gian P_SYS_BUS nhu ban cu -
  du thua vi P_ROCC_NOC DA la bien gioi
  ngoai cung roi).
end note

@enduml
