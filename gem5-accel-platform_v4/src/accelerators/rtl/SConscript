# src/accelerators/rtl/SConscript
#
# Compiles rtl/npu_mac_core.v with Verilator into a static library BEFORE
# gem5's normal C++ sources are compiled, then exposes the include path
# and library to the parent SConscript (src/accelerators/SConscript) so
# npu_accel_rtl.cc can #include "Vnpu_mac_core.h" and link against it.
#
# This uses a pre-generated-static-library approach rather than asking
# SCons to manage Verilator's individual generated .cpp files directly:
# Verilator's own generated Makefile already knows how to build a correct
# static archive (handling its own internal file dependencies, which
# change between Verilator versions), so we just shell out to `verilator`
# + `make` once and treat the result as a build artifact/dependency, the
# same way you might vendor a prebuilt third-party library.
#
# IMPORTANT: this SConscript has NOT been exercised in a full gem5 build
# in this environment (a full scons build/RISCV/gem5.opt run is
# prohibitively slow to do in this session - see RTL-INTEGRATION.md,
# section "Mức do kiem chung"). The Verilog + testbench THEMSELVES are
# fully verified (compiled and run standalone with real Verilator,
# producing a numerically-correct result - see test/standalone_test.cpp
# and RTL-INTEGRATION.md). Treat this file as a well-reasoned starting
# point to debug against, not a guaranteed-working recipe - see
# RTL-INTEGRATION.md's troubleshooting section for what to check first
# if the build fails here.

Import('*')

import os

rtl_dir = Dir('.')
obj_dir = Dir('obj_dir')

verilator_include = '/usr/share/verilator/include'

rtl_lib = env.Command(
    target=[
        obj_dir.File('Vnpu_mac_core__ALL.a'),
        obj_dir.File('Vnpu_mac_core.h'),
    ],
    source=['npu_mac_core.v'],
    action=[
        'verilator --cc $SOURCE --Mdir ' + obj_dir.abspath + ' -Wall',
        'make -C ' + obj_dir.abspath +
            ' -f Vnpu_mac_core.mk Vnpu_mac_core__ALL.a',
    ],
)

# Make the generated header (Vnpu_mac_core.h) and Verilator's own runtime
# headers (verilated.h etc.) visible to npu_accel_rtl.cc.
env.Append(CPPPATH=[obj_dir.abspath, verilator_include,
                     verilator_include + '/vltstd'])

# Verilator-generated code expects these (matches the flags Verilator's
# own generated Makefile uses - see the `verilator --cc --build` output
# during standalone testing for reference values).
env.Append(CPPDEFINES=['VM_COVERAGE=0', 'VM_SC=0', 'VM_TRACE=0',
                        'VM_TRACE_FST=0', 'VM_TRACE_VCD=0'])

env.Append(LIBS=['npu_mac_core__ALL'])
env.Append(LIBPATH=[obj_dir.abspath])

# Verilator's own small runtime (not the model-specific code) - compiled
# once here and reused; every Verilated model in this build needs it.
env.Append(CXXFLAGS=['-faligned-new'])
runtime_sources = [
    verilator_include + '/verilated.cpp',
    verilator_include + '/verilated_threads.cpp',
]
for src in runtime_sources:
    Source(src)

Depends('#src/accelerators/npu_accel_rtl.cc', rtl_lib)
