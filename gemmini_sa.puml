@startuml
skinparam componentStyle uml2
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultTextAlignment center
skinparam nodesep 50
skinparam ranksep 40

' Định dạng khung ngoài của Accelerator
skinparam package {
    BackgroundColor Transparent
    BorderColor #333333
    BorderThickness 2
    FontSize 18
    FontStyle bold
}

' Định dạng các Sub-module lớn
skinparam rectangle {
    RoundCorner 8
    BorderThickness 1.5
    BorderColor #555555
    FontSize 15
    FontStyle bold
}

' Định dạng các khối linh kiện
skinparam component {
    RoundCorner 4
    BorderThickness 1
    BorderColor #777777
    BackgroundColor #FFFFFF
    FontSize 14
}

' ==========================================
' EXTERNAL INTERFACES
' ==========================================
interface "io.cmd\n(RoCC Command)" as P_CMD #F4B183
interface "io.busy\n(Aggregated Busy Status)" as P_BUSY #FF7F50
interface "io.resp\n(Counter Writeback rd)" as P_RESP #F4B183

interface "io.ptw\n(L1 TLB Miss Walk)" as P_PTW #F4B183
interface "io.mem\n(TileLink DMA)" as P_MEM #F4B183

' ==========================================
' GEMMINI ACCELERATOR INTERNAL STRUCTURE
' ==========================================
package "Gemmini Accelerator" {

    ' Khối Điều khiển Frontend (Controller)
    rectangle "Controller & Frontend" as CTRL #E8F8F5 {
        component "Loop Unroller\n(Command Dispatcher)" as Unroller
        
        component "Reservation Station\n(ld_q | ex_q | st_q\n+ Dependency Logic)" as DepMgmt
        
        component "DMA Engine\n(Load/Store Controllers)" as DMA
        component "Local L1 TLB\n(Shared Size=4)" as L1TLB
        
        Unroller -down-> DepMgmt : " Push Micro-ops"
        DepMgmt -down-> DMA : " Issue Load/Store"
        DMA <-right-> L1TLB : " VA -> PA Translation"
        
        ' Tín hiệu Flush L1 TLB khi nhận FLUSH_CMD từ Manager
        Unroller -right-> L1TLB : " Flush (SFENCE.VMA)"
    }

    ' Khối Tính toán & Biến đổi (Execution & Transposer)
    rectangle "Execution & Data Transformation" as ENGINE #FCF3CF {
        component "Transposer Unit\n(Matrix Reordering)" as Transposer
        component "Systolic Array\n(16x16 PEs Mesh)" as Mesh
    }

    ' Khối Bộ nhớ cục bộ (Storage & Formatting Pipeline)
    rectangle "Local Storage & Pipelines" as STORAGE #EAECEE {
        component "Scratchpad SRAM\n(Bank 0 ... Bank K)" as SPAD
        
        rectangle "Accumulator Subsystem" as ACC_SUB #FFFFFF {
            component "Accumulator SRAM\n(Partial Sums D)" as ACC
            component "ReLU Activation" as RELU
            component "Scaling Unit" as SCALE
            
            ACC -right-> RELU : " Pipeline Read"
            RELU -right-> SCALE
        }
    }

    ' ------------------------------------------
    ' INTERNAL ROUTING (Đường đi dữ liệu tinh chỉnh)
    ' ------------------------------------------
    
    ' Lệnh Execute đi xuống Systolic Array
    DepMgmt -right-> Mesh : " Issue Execute Ops"
    
    ' Transposer hỗ trợ luồng dữ liệu vào Scratchpad / Array
    SPAD <--> Transposer : " Data Reordering"
    Transposer --> Mesh
    
    ' Luồng DMA Load (mvin) rẽ nhánh linh hoạt
    DMA -down-> SPAD : " mvin -> Scratchpad (A,B)"
    DMA -down-> ACC : " mvin -> Accumulator (D)"
    
    ' Luồng DMA Store (mvout) qua Pipeline ReLU/Scaling
    SCALE -up-> DMA : " mvout (Processed Data)"
    SPAD -up-> DMA : " mvout (Raw Data)"
    
    ' Luồng Systolic Array tính toán với Bộ nhớ
    Mesh <-left-> SPAD : " Read Operands A, B"
    Mesh <-down-> ACC : " Read/Write Partial Sums D"

    ' Tổng hợp tín hiệu Trạng thái (io.busy logic)
    Unroller -up-> P_BUSY : " Unroller Active"
    DepMgmt -up-> P_BUSY : " Queues / Solitary Preload"
    DMA -up-> P_BUSY : " DMA In-flight"
    DepMgmt -up-> P_RESP : " COUNTER_OP Result"
}

' ==========================================
' EXTERNAL CONNECTIONS
' ==========================================
P_CMD -down-> Unroller : " RoCC Cmd Stream"
L1TLB -up-> P_PTW : " TLB Miss / PTW"
DMA -up-> P_MEM : " TileLink Requests"

@endregion

@enduml
